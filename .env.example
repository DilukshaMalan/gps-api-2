# Copy to .env and run:  node --env-file=.env index.js     (Node 20.6+)
# or set these in the Railway / Render "Variables" tab. All values are optional.
PORT=8000
GPS_DATA_DIR=./data
GPS_API_KEY=change-me          # leave unset to run without authentication (local development only)
GPS_MAX_RANGE_DAYS=31
GPS_GZIP_MIN_BYTES=1000
GPS_ACCESS_LOG=0               # 1 = print one log line per request
